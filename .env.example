# ============ Configuración del catálogo Antü ============
# Cualquier ruta de imagen apunta a un archivo dentro de la carpeta "public".
# Podes reemplazar los archivos, o crear nuevas carpetas e indicar la ruta acá.

# URL base de la API del backend NestJS.
# Desarrollo local: "/api" (Vite lo proxya a http://localhost:3000).
# Producción: URL completa del backend, ej: "https://backend-ant-zn4x.onrender.com/api"
VITE_API_URL=/api

# Numero de WhatsApp donde llegan los pedidos.
# Formato internacional, solo digitos y codigo de pais, sin + ni espacios.
# Ejemplo para Argentina: 5491123456789
VITE_WHATSAPP_NUMBER=

# Nombre del negocio que se muestra en el sitio y en el pedido.
VITE_NEGOCIO_NOMBRE=Antü

# ====================== LOGO ======================
# Logo de Antu. Reemplaza el archivo public/logo.svg por tu logo
# (puede ser SVG, PNG o JPG) y deja la ruta en /logo.svg, o crea una
# carpeta en public y apunta aca, por ejemplo: /logos/mi-logo.png
VITE_LOGO_URL=/logo.svg

# ====================== FONDO ======================
# Imagen de fondo del hero del catálogo (reemplazala con una foto real en public/).
VITE_FONDO_URL=/fondo.svg

# ====================== BANNERS ======================
# Carrusel de banners en la portada. Para cambiar un banner, reemplaza el
# archivo SVG en public/banners (o usa JPG/PNG y cambia la ruta).
# Los textos son OPCIONALES: si los vacias, el banner solo muestra la imagen.
VITE_BANNER_1=/banners/banner-1.svg
VITE_BANNER_TITULO_1=
VITE_BANNER_SUBTITULO_1=

VITE_BANNER_2=/banners/banner-2.svg
VITE_BANNER_TITULO_2=
VITE_BANNER_SUBTITULO_2=

VITE_BANNER_3=/banners/banner-3.svg
VITE_BANNER_TITULO_3=
VITE_BANNER_SUBTITULO_3=

# ====================== IMÁGENES DE CATEGORÍAS ======================
# Imagen para cada categoría. Se usa cuando el backend no trae la imagen.
# Formato JSON: {"Nombre exacto de la categoria": "/ruta/imagen.jpg"}
# Crea las imágenes dentro de public/categorias/, por ejemplo:
# VITE_CATEGORIA_IMAGENES={"Velas": "/categorias/velas.jpg", "Textiles": "/categorias/textiles.jpg"}
VITE_CATEGORIA_IMAGENES={}