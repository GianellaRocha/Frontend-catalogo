# ============ Configuración del catálogo Antü (PRODUCCIÓN) ============

# URL base de la API del backend NestJS desplegado en Render.
VITE_API_URL=https://backend-ant-zn4x.onrender.com/api

# Numero de WhatsApp donde llegan los pedidos.
VITE_WHATSAPP_NUMBER=5493537335881

# Nombre del negocio que se muestra en el sitio y en el pedido.
VITE_NEGOCIO_NOMBRE=Antü

# ====================== LOGO ======================
VITE_LOGO_URL=/logo.svg

# ====================== FONDO ======================
VITE_FONDO_URL=/fondo.svg

# ====================== BANNERS ======================
VITE_BANNER_1=/banners/banner-1.svg
VITE_BANNER_TITULO_1=Nuevos productos artesanales
VITE_BANNER_SUBTITULO_1=Explorá la colección y pedí en un click.

VITE_BANNER_2=/banners/banner-2.svg
VITE_BANNER_TITULO_2=Envíos a todo el país
VITE_BANNER_SUBTITULO_2=Consultá costos y tiempos por WhatsApp.

VITE_BANNER_3=/banners/banner-3.svg
VITE_BANNER_TITULO_3=
VITE_BANNER_SUBTITULO_3=

# ====================== IMÁGENES DE CATEGORÍAS ======================
VITE_CATEGORIA_IMAGENES={}